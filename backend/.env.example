# Application identity and local Vue origin.
APP_NAME=ASTRA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Casablanca
APP_LOCALE=fr
FRONTEND_URL=http://localhost:5173

APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker containers use the service name "database"; host tools such as DBeaver use 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=astra
DB_USERNAME=astra
DB_PASSWORD=astra_local_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Reverb broadcasts server events; the Vue frontend connects through port 8080.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=astra-local
REVERB_APP_KEY=astra-local-key
REVERB_APP_SECRET=astra-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payment provider test mode. Never commit real secrets.
PAYMENT_PROVIDER=stripe
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
FRONTEND_PAYMENT_SUCCESS_URL=http://localhost:5173/payment/success
FRONTEND_PAYMENT_CANCEL_URL=http://localhost:5173/payment/cancelled

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

VITE_APP_NAME="${APP_NAME}"
